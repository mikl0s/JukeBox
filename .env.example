# .env.local
# Environment variables for the Jukebox application

# Server port
PORT=4000

# Relative path to the music folder from the project root
MUSIC_FOLDER=music

# Relative path to the YouTube audio folder from the project root
YOUTUBE_FOLDER=youtube

# Database filename (LokiJS)
DB_FILENAME=jukebox.db.json

# Number of days for stats graph
STATS_DAYS=7

# Enable/disable browser console debug logging (true/false)
DEBUG_LOGGING=false

# --- Optional ---
# Playlist title prefix to remove (client-side display only currently)
# Leave empty if no prefix removal is needed in JS
# PLAYLIST_PREFIX_FILTER="^Tuesday Boys\s+"

# YouTube cookies file path (for bypassing bot detection)
# Export cookies from Chrome using an extension like "Get cookies.txt LOCALLY"
# Then mount the file to your container and set the path here
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
